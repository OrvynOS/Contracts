pragma solidity ^0.8.24;

import {IERC20} from "@openzeppelin/contracts/token/ERC20/IERC20.sol";
import {SafeERC20} from "@openzeppelin/contracts/token/ERC20/utils/SafeERC20.sol";
import {ReentrancyGuard} from "@openzeppelin/contracts/utils/ReentrancyGuard.sol";
import {Ownable2Step, Ownable} from "@openzeppelin/contracts/access/Ownable2Step.sol";
import {AgentIdGated, IAgentId} from "./AgentIdGated.sol";
import {PoseidonTree} from "./PoseidonTree.sol";

/// @notice Groth16 verifier generated by snarkjs from circuits/transaction.circom
/// (`snarkjs zkey export solidityverifier`). Public signals, in circuit order:
/// [root, keyRoot, publicAmount, extDataHash, asset, inputNullifier0, inputNullifier1,
///  outputCommitment0, outputCommitment1].
interface IVerifier {
    function verifyProof(uint256[2] calldata a, uint256[2][2] calldata b, uint256[2] calldata c, uint256[9] calldata input)
        external
        view
        returns (bool);
}

/// @title OrvynPay (private mode): shielded pool for verified agents
/// @notice A UTXO shielded pool (2 inputs, 2 outputs per transaction) for USDT, USDC and BNB.
/// A note is `Poseidon(amount, ownerKey, blinding, asset)`; spending one reveals only its
/// nullifier `Poseidon(commitment, index, Poseidon(privateKey, commitment, index))`, so deposits,
/// transfers and withdrawals can't be linked on chain.
///
/// Only Binance Agent ID holders can use it, on both sides of every payment:
/// - Shielded keys: an agent registers its shielded public key here, only while its wallet holds
///   an Agent ID. The circuit proves every non-zero output note belongs to a registered key, so
///   value inside the pool can only ever move between verified agents.
/// - Deposits: the depositing wallet must hold an Agent ID.
/// - Withdrawals: the recipient (and any relayer taking a fee) must hold an Agent ID.
///
/// The owner can list assets, cap deposits and pause new deposits while the pool is young. It can
/// never pause withdrawals, change the verifier or the Agent ID registry, or touch shielded funds.
contract OrvynShieldedPool is AgentIdGated, ReentrancyGuard, Ownable2Step {
    using SafeERC20 for IERC20;
    using PoseidonTree for PoseidonTree.Tree;

    uint256 public constant FIELD_SIZE = PoseidonTree.FIELD_SIZE;
    int256 public constant MAX_EXT_AMOUNT = 2 ** 248;
    uint256 public constant MAX_FEE = 2 ** 248;
    address public constant NATIVE = address(0);
    uint32 public constant COMMITMENT_ROOT_HISTORY = 100;
    uint32 public constant KEY_ROOT_HISTORY = 100;

    IVerifier public immutable verifier;

    struct ExtData {
        address recipient; // withdrawals
        int256 extAmount; // > 0 deposit, < 0 withdrawal, 0 shielded transfer
        address relayer;
        uint256 fee; // paid to the relayer out of the pool, in the same asset
        bytes encryptedOutput1;
        bytes encryptedOutput2;
    }

    struct Proof {
        uint256[2] a;
        uint256[2][2] b;
        uint256[2] c;
        uint256 root;
        uint256 keyRoot;
        uint256 publicAmount;
        uint256 extDataHash;
        uint256 asset; // uint160(token), 0 for BNB
        uint256[2] inputNullifiers;
        uint256[2] outputCommitments;
    }

    struct Asset {
        bool accepted;
        uint256 maxDeposit; // per transaction, 0 = no limit
    }

    PoseidonTree.Tree private _notes;
    PoseidonTree.Tree private _keys;
    mapping(uint256 nullifier => bool) public nullifierSpent;
    mapping(address token => Asset) public assets;
    mapping(address account => uint256) public shieldedKeyOf;
    mapping(uint256 shieldedKey => bool) public keyRegistered;
    bool public depositsPaused;

    event NewCommitment(uint256 commitment, uint256 index, bytes encryptedOutput);
    event NewNullifier(uint256 nullifier);
    event KeyRegistered(address indexed account, uint256 shieldedKey, bytes encryptionKey, uint256 index);
    event AssetSet(address indexed token, bool accepted, uint256 maxDeposit);
    event DepositsPaused(bool paused);

    error UnknownRoot();
    error UnknownKeyRoot();
    error NullifierSpent();
    error DuplicateNullifier();
    error BadExtData();
    error BadPublicAmount();
    error BadAsset();
    error AssetNotAccepted();
    error DepositLimit();
    error Paused();
    error BadValue();
    error BadProof();
    error BadKey();
    error KeyExists();
    error TransferFailed();

    constructor(
        IVerifier verifier_,
        IAgentId agentIdRegistry_,
        uint32 noteLevels,
        uint32 keyLevels,
        address owner_
    ) AgentIdGated(agentIdRegistry_) Ownable(owner_) {
        verifier = verifier_;
        _notes.init(noteLevels, COMMITMENT_ROOT_HISTORY);
        _keys.init(keyLevels, KEY_ROOT_HISTORY);
    }

    // ---------- Admin ----------

    function setAsset(address token, bool accepted, uint256 maxDeposit) external onlyOwner {
        assets[token] = Asset(accepted, maxDeposit);
        emit AssetSet(token, accepted, maxDeposit);
    }

    function setDepositsPaused(bool paused) external onlyOwner {
        depositsPaused = paused;
        emit DepositsPaused(paused);
    }

    // ---------- Shielded keys ----------

    /// @notice Register the caller's shielded public key (`Poseidon(privateKey)`) and the key
    /// senders encrypt notes to. Requires an Agent ID. One key per wallet.
    function registerKey(uint256 shieldedKey, bytes calldata encryptionKey) external {
        _requireAgentId(msg.sender);
        if (shieldedKey == 0 || shieldedKey >= FIELD_SIZE) revert BadKey();
        if (shieldedKeyOf[msg.sender] != 0 || keyRegistered[shieldedKey]) revert KeyExists();
        shieldedKeyOf[msg.sender] = shieldedKey;
        keyRegistered[shieldedKey] = true;
        uint32 index = _keys.insert(shieldedKey);
        emit KeyRegistered(msg.sender, shieldedKey, encryptionKey, index);
    }

    // ---------- Transactions ----------

    /// @notice Deposit, transfer within the pool, or withdraw, with a proof of a 2-in/2-out
    /// transaction. BNB deposits send `extAmount` as value.
    function transact(Proof calldata p, ExtData calldata e) external payable nonReentrant {
        if (!_notes.isKnownRoot(p.root)) revert UnknownRoot();
        if (!_keys.isKnownRoot(p.keyRoot)) revert UnknownKeyRoot();
        if (p.inputNullifiers[0] == p.inputNullifiers[1]) revert DuplicateNullifier();
        if (nullifierSpent[p.inputNullifiers[0]] || nullifierSpent[p.inputNullifiers[1]]) revert NullifierSpent();
        if (uint256(keccak256(abi.encode(e))) % FIELD_SIZE != p.extDataHash) revert BadExtData();
        if (p.publicAmount != publicAmountOf(e.extAmount, e.fee)) revert BadPublicAmount();
        if (p.asset >= (uint256(1) << 160)) revert BadAsset();
        address token = address(uint160(p.asset));
        if (!verifier.verifyProof(p.a, p.b, p.c, _signals(p))) revert BadProof();

        // Effects
        nullifierSpent[p.inputNullifiers[0]] = true;
        nullifierSpent[p.inputNullifiers[1]] = true;
        uint32 index = _notes.insertPair(p.outputCommitments[0], p.outputCommitments[1]);
        emit NewNullifier(p.inputNullifiers[0]);
        emit NewNullifier(p.inputNullifiers[1]);
        emit NewCommitment(p.outputCommitments[0], index, e.encryptedOutput1);
        emit NewCommitment(p.outputCommitments[1], index + 1, e.encryptedOutput2);

        // Interactions
        if (e.extAmount > 0) {
            uint256 amount = uint256(e.extAmount);
            Asset memory a = assets[token];
            if (depositsPaused) revert Paused();
            if (!a.accepted) revert AssetNotAccepted();
            if (a.maxDeposit != 0 && amount > a.maxDeposit) revert DepositLimit();
            _requireAgentId(msg.sender);
            if (token == NATIVE) {
                if (msg.value != amount) revert BadValue();
            } else {
                if (msg.value != 0) revert BadValue();
                uint256 before = IERC20(token).balanceOf(address(this));
                IERC20(token).safeTransferFrom(msg.sender, address(this), amount);
                if (IERC20(token).balanceOf(address(this)) - before != amount) revert BadValue();
            }
        } else if (msg.value != 0) {
            revert BadValue();
        }
        if (e.extAmount < 0) {
            // Withdrawals stay open even for de-listed assets, so funds can always leave.
            _requireAgentId(e.recipient);
            _send(token, e.recipient, uint256(-e.extAmount));
        }
        if (e.fee > 0) {
            _requireAgentId(e.relayer);
            _send(token, e.relayer, e.fee);
        }
    }

    /// @notice The circuit's publicAmount for an external amount and relayer fee (mod the field).
    function publicAmountOf(int256 extAmount, uint256 fee) public pure returns (uint256) {
        if (fee >= MAX_FEE) revert BadPublicAmount();
        if (extAmount <= -MAX_EXT_AMOUNT || extAmount >= MAX_EXT_AMOUNT) revert BadPublicAmount();
        int256 amount = extAmount - int256(fee);
        return amount >= 0 ? uint256(amount) : FIELD_SIZE - uint256(-amount);
    }

    // ---------- Views ----------

    function noteRoot() external view returns (uint256) {
        return _notes.lastRoot();
    }

    function keyRoot() external view returns (uint256) {
        return _keys.lastRoot();
    }

    function isKnownNoteRoot(uint256 root) external view returns (bool) {
        return _notes.isKnownRoot(root);
    }

    function isKnownKeyRoot(uint256 root) external view returns (bool) {
        return _keys.isKnownRoot(root);
    }

    function nextNoteIndex() external view returns (uint32) {
        return _notes.nextIndex;
    }

    function nextKeyIndex() external view returns (uint32) {
        return _keys.nextIndex;
    }

    // ---------- Internal ----------

    function _signals(Proof calldata p) private pure returns (uint256[9] memory s) {
        s[0] = p.root;
        s[1] = p.keyRoot;
        s[2] = p.publicAmount;
        s[3] = p.extDataHash;
        s[4] = p.asset;
        s[5] = p.inputNullifiers[0];
        s[6] = p.inputNullifiers[1];
        s[7] = p.outputCommitments[0];
        s[8] = p.outputCommitments[1];
    }

    function _send(address token, address to, uint256 amount) private {
        if (token == NATIVE) {
            (bool ok,) = to.call{value: amount}("");
            if (!ok) revert TransferFailed();
        } else {
            IERC20(token).safeTransfer(to, amount);
        }
    }
}
